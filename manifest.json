{
  "manifest_version": 3,
  "name": "Style Scratcher - 피그마 스타일 웹 인스펙터 & CSS 튜너",
  "short_name": "StyleScratcher",
  "version": "4.0.1",
  "description": "디자이너와 개발자를 위한 화이트 미니멀 피그마 감성 웹 인스펙터 & 에디트 스튜디오 v4.0.1. 2줄 탭 네비게이션(설정 및 10개 탭 직관 노출), 벡터 SVG 아이콘, 레드 스튜디오 테마, 검사/편집 모드 분리, 디바이스 뷰포트 목업, 피그마 폰트 스튜디오 및 Hug/Fill/Fixed 감지, 병렬 글리프 수확기, W3C 탭 순서 시각화, 스마트 HUD, React JSX 추출.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Style Scratcher 열기 (Alt+S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/event-interceptor.js",
        "content/unit-converter.js",
        "content/instant-zoom.js",
        "content/interaction-detector.js",
        "content/graphics-inspector.js",
        "content/page-controller.js",
        "content/motion-inspector.js",
        "content/color-suite.js",
        "content/asset-editor.js",
        "content/precision-cursor.js",
        "content/mode-manager.js",
        "content/device-mockup.js",
        "content/tab-order-visualizer.js",
        "content/font-studio.js",
        "content/context-hud.js",
        "content/shortcut-manager.js",
        "content/react-exporter.js",
        "content/css-beautifier.js",
        "content/tailwind-converter.js",
        "content/palette-extractor.js",
        "content/overlay-canvas.js",
        "content/style-tweaker.js",
        "content/components/floating-dock.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/styles/shadow-styles.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-scratcher": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Style Scratcher 인스펙터 토글"
    }
  }
}
